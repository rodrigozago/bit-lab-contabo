# A análise de imagem é 100% local (processamento digital, sem IA) — não
# precisa de nenhuma variável de ambiente pra isso.

# client OIDC do bordado-digital (SSO via bit-lab-agents/auth) — mesmo valor de
# BORDADO_DIGITAL_OIDC_SECRET no auth/.env
BORDADO_DIGITAL_OIDC_SECRET=troque_por_um_secret_aleatorio_longo

# Postgres — persistência real dos projetos (DATA-1)
POSTGRES_PASSWORD=troque_esta_senha

# Limpeza automática de exports/ e uploads/ (INF-4) — arquivos mais velhos que
# isso são apagados a cada hora. Opcionais, default 24h se não definidas.
# EXPORTS_TTL_HOURS=24
# UPLOADS_TTL_HOURS=24

# ── Rollbar (rastreio de erros) — Fase 10 / SEGURANCA-PRE-LANCAMENTO.md item 6 ──
# Sem esses tokens, o Rollbar fica DESLIGADO (no-op) em todas as superfícies.
# Token SERVIDOR (secreto, post_server_item) — usado pela API e pelo worker:
ROLLBAR_SERVER_TOKEN=
# Token CLIENTE (público, post_client_item) — usado pelo front (web). O prefixo
# VITE_ é obrigatório pro Vite expor a var pro bundle do browser:
VITE_ROLLBAR_CLIENT_TOKEN=
# (opcional) hash do build, pra agrupar erros do front por versão no Rollbar:
# VITE_BUILD_SHA=

# ── Métricas do worker → Slack (Incoming Webhook) ───────────────────────────────
# O worker posta 1 mensagem por job (análise/export/preview/stitch_data) com
# tempo, nº de pontos, áreas, tamanho e profundidade da fila — e um alerta quando
# a fila acumula. Vai direto pro Slack (não pro Rollbar, que fica só pros erros),
# então não gasta cota do Rollbar. Sem a webhook, o worker não posta nada (no-op).
# Crie em: Slack → Apps → Incoming Webhooks → escolha o canal (#ponto-metrics).
# SLACK_METRICS_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Acima deste tamanho de fila, o worker manda o alerta de backlog. Default 20.
# QUEUE_DEPTH_WARN=20
# (opcional) rótulo do ambiente nas mensagens do Slack e no Rollbar. Default production.
# ROLLBAR_ENV=production
