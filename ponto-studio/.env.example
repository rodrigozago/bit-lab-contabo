# A análise de imagem é 100% local (processamento digital, sem IA) — não
# precisa de nenhuma variável de ambiente pra isso.

# client OIDC do ponto-studio (SSO via bit-lab-agents/auth) — mesmo valor de
# PONTO_STUDIO_OIDC_SECRET no auth/.env
PONTO_STUDIO_OIDC_SECRET=troque_por_um_secret_aleatorio_longo

# Postgres — persistência real dos projetos (DATA-1)
POSTGRES_PASSWORD=troque_esta_senha
