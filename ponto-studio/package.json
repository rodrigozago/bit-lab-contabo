{
  "name": "ponto-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "description": "Bordado Digital \u2014 plataforma web para design e exporta\u00e7\u00e3o de bordados",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter \"./apps/*\" run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
