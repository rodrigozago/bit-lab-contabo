# client OIDC do sentinela (SSO via bit-lab-agents/auth) — mesmo valor de
# SENTINELA_OIDC_SECRET no auth/.env
SENTINELA_OIDC_SECRET=troque_por_um_secret_aleatorio_longo

# Postgres
POSTGRES_PASSWORD=troque_esta_senha

# OpenAI — usado pelo worker de análise (sentimento, entidades, embeddings)
OPENAI_API_KEY=

# Scrapoxy — proxy pool na frente dos workers de ingestão (evita rate-limit/ban)
SCRAPOXY_API_URL=http://scrapoxy:8888
SCRAPOXY_API_TOKEN=troque_por_um_token_aleatorio
# endpoint público do Scrapoxy usado como proxy padrão pelas contas X que não
# têm um proxy dedicado (worker-ingest-social) — porta 8888 é o proxy de
# verdade, diferente da 8890 (painel admin, exposto no docker-compose.yml)
SCRAPOXY_PROXY_URL=http://scrapoxy:8888

# chave de criptografia (AES-256-GCM) das credenciais do pool de contas X
# (tabela social_accounts — ver workers/ingest-social/crypto.py). Gere com:
#   openssl rand -base64 32
# Perder essa chave = perder acesso às contas cadastradas (não tem como
# recuperar); trocar ela invalida todas as contas já salvas.
SOCIAL_ACCOUNTS_ENCRYPTION_KEY=

# ── Rollbar (rastreio de erros) — mesmo padrão dos outros apps bit-lab ──
ROLLBAR_SERVER_TOKEN=
VITE_ROLLBAR_CLIENT_TOKEN=
