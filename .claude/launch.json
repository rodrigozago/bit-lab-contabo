{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "on-air-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "pnpm@9.15.4", "-C", "on-air", "--filter", "@on-air/web", "dev"],
      "port": 5173
    },
    {
      "name": "face-lab-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "pnpm@9.15.4", "-C", "face-lab", "--filter", "@face-lab/web", "dev"],
      "port": 5173
    },
    {
      "name": "face-lab-storybook",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "pnpm@9.15.4", "-C", "face-lab", "--filter", "@face-lab/web", "storybook"],
      "port": 6006
    },
    {
      "name": "ponto-studio-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "pnpm@9.15.4", "-C", "ponto-studio", "--filter", "@ponto-studio/web", "dev"],
      "port": 3000
    },
    {
      "name": "sentinela-web",
      "runtimeExecutable": "npx",
