# Storyblok — space na região EU
# Content Delivery API: token público (conteúdo publicado, entra no build)
NEXT_PUBLIC_STORYBLOK_PUBLIC_TOKEN=

# Content Delivery API: token de preview (só usado quando draft mode está ligado)
STORYBLOK_PREVIEW_TOKEN=

# Segredo pra validar /preview?secret=... antes de ligar o draft mode
STORYBLOK_PREVIEW_SECRET=

# Segredo pra validar o webhook de revalidação (story.published / story.unpublished)
STORYBLOK_WEBHOOK_SECRET=

# Área studio.bit-lab.tech — login via SSO (auth.bit-lab.tech), páginas
# `visibility: private` do Storyblok exigem sessão. Ver src/lib/studio-oidc.ts
# e src/lib/studio-session.ts.
STUDIO_OIDC_ISSUER=https://auth.bit-lab.tech
STUDIO_OIDC_CLIENT_ID=studio
# Precisa ser igual ao STUDIO_OIDC_SECRET configurado em auth/.env
STUDIO_OIDC_CLIENT_SECRET=

# Assina os cookies de sessão/PKCE da área studio (jose/HS256) — gere um
# valor aleatório longo, ex.: openssl rand -base64 32
STUDIO_SESSION_SECRET=
