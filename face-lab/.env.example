# ── Infra ──────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque_esta_senha
SESSION_SECRET=troque_por_uma_string_aleatoria_longa

# ── SSO (bit-lab-auth) ─────────────────────────────────────────────────────────
# OIDC_CLIENT_SECRET deve ser IGUAL a FACE_LAB_OIDC_SECRET no auth/.env
OIDC_ISSUER=https://auth.bit-lab.tech
OIDC_CLIENT_ID=face-lab
OIDC_CLIENT_SECRET=troque_por_um_secret_aleatorio_longo

# URL pública do app (dev local: http://localhost:3004)
PUBLIC_URL=https://face.bit-lab.tech

# ── Google Drive (OAuth do producer) ──────────────────────────────────────────
# Google Cloud Console → projeto → Drive API habilitada → OAuth Client (Web):
#   redirect URI: https://face.bit-lab.tech/api/google/callback
#   (+ http://localhost:3004/api/google/callback pra dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://face.bit-lab.tech/api/google/callback
# 32 bytes em hex (64 chars) — gere com: openssl rand -hex 32
GOOGLE_TOKEN_ENC_KEY=

# ── Matching / limites ─────────────────────────────────────────────────────────
# distância de cosseno máxima pra considerar match (ArcFace; menor = mais rígido)
MATCH_DISTANCE_THRESHOLD=0.4
# distância máxima pra agrupar faces na mesma pessoa (cluster) dentro de um álbum
CLUSTER_DISTANCE_THRESHOLD=0.45
# score mínimo de detecção de rosto no worker (subir pra 0.6 corta figurantes)
DET_SCORE_MIN=0.5
# (admin do face-lab = quem tem is_admin no bit-lab-auth, via claim do OIDC)
# reconhecimentos (fotos processadas) por minuto — só pra conter os testes por ora
RATE_LIMIT_PRODUCER_PER_MIN=30
RATE_LIMIT_GLOBAL_PER_MIN=60
RATE_LIMIT_ENROLL_PER_MIN=10
