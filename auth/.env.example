POSTGRES_PASSWORD=troque_esta_senha
SESSION_SECRET=troque_por_uma_string_aleatoria_longa
INITIAL_ADMIN_EMAIL=voce@bit-lab.tech
INITIAL_ADMIN_PASSWORD=troque_esta_senha_tambem
# client OIDC do face-lab — mesmo valor de OIDC_CLIENT_SECRET no face-lab/.env
FACE_LAB_OIDC_SECRET=troque_por_um_secret_aleatorio_longo
# client OIDC do bordado-digital — mesmo valor de OIDC_CLIENT_SECRET no ponto-studio/.env
BORDADO_DIGITAL_OIDC_SECRET=troque_por_um_secret_aleatorio_longo
# client OIDC do sentinela — mesmo valor de SENTINELA_OIDC_SECRET no sentinela/.env
SENTINELA_OIDC_SECRET=troque_por_um_secret_aleatorio_longo
# self-signup não é mais uma flag global — cada app tem seu próprio toggle
# "allow_self_signup", configurável pelo superuser em apps.bit-lab.tech/admin/apps.
# Contas novas só entram por link de convite (apps.bit-lab.tech/admin/tokens)
# ou self-signup do app específico — não existe mais fila de solicitação.
# Rollbar (rastreio de erros) — vazio = desligado. Token SERVIDOR secreto,
# próprio do auth (ver ponto-studio/docs/SEGURANCA-PRE-LANCAMENTO.md item 6).
ROLLBAR_SERVER_TOKEN=
# Microserviço de e-mail (convite, esqueci-senha, verificação de e-mail) —
# ver email/README.md. Sem essas duas vars, os envios falham silenciosamente
# (loga no Rollbar, não derruba o fluxo) e os fallbacks manuais continuam
# funcionando (ex.: copiar o link de convite no painel).
MAIL_SERVICE_URL=https://mail.bit-lab.tech
# mesmo valor de INTERNAL_KEY no email/.env
MAIL_INTERNAL_KEY=troque_por_um_segredo_aleatorio_longo
