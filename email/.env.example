# Chave de API do Resend (https://resend.com/api-keys) — sem ela o serviço
# sobe mas todo envio falha (erro explícito, não no-op silencioso).
RESEND_API_KEY=re_xxx

# Remetente. Precisa ser um domínio verificado no Resend (SPF/DKIM via DNS)
# pra produção — em dev, use o sandbox do Resend: onboarding@resend.dev
EMAIL_FROM=bit-lab <no-reply@bit-lab.tech>

# Chave compartilhada que os serviços internos (auth, futuramente outros)
# mandam no header X-Internal-Key pra poder chamar POST /send. Gere com:
#   openssl rand -hex 32
# Mesmo valor precisa estar em auth/.env como MAIL_INTERNAL_KEY.
INTERNAL_KEY=troque_por_um_segredo_aleatorio_longo
